{
  "expo": {
    "name": "Fil",
    "slug": "fil",
    "owner": "rm-corp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "fil",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "JK46G84XCP",
      "bundleIdentifier": "com.matteo81.fil",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.matteo81.fil.widgets"]
      },
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Fil a besoin d'accéder à tes photos pour les ajouter à votre album partagé.",
        "NSCameraUsageDescription": "Fil peut utiliser l'appareil photo pour ajouter des photos à votre album partagé.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.matteo81.fil",
      "adaptiveIcon": {
        "backgroundColor": "#1B1B3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-image",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D8C7AC",
          "image": "./assets/icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fil a besoin d'accéder à tes photos pour les ajouter à votre album partagé."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2A65A"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Fil utilise Face ID pour verrouiller l'application et protéger votre intimité."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fil utilise ta position pour afficher ta ville, la distance et la météo à ta moitié."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Fil utilise le micro pour enregistrer tes messages vocaux « Tu me manques »."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Fil utilise ta position pour te situer sur la carte de vos souvenirs."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      "@bacons/apple-targets"
    ],
    "extra": {
      "eas": {
        "projectId": "130c68d6-1af0-4ec7-ae2a-6b5ac03afaf0"
      },
      "router": {}
    }
  }
}
